# Postgres (matches docker-compose.yml — host port 5433 to avoid clashing with
# another local Postgres instance already bound to 5432 on this machine)
DATABASE_URL=postgres://mydoners:mydoners_dev@localhost:5433/mydoners

# Redis (host port 6380 — same reason, 6379 was already in use locally)
REDIS_URL=redis://localhost:6380

# Telegram
TELEGRAM_BOT_TOKEN=

# Auth
JWT_SECRET=

# Android KDS device auth (per docs/auth-contract.md #2 — set after generating a device key)
# (device keys live in the device_keys table, not here — this is just for local single-device dev convenience)

# Courier Bot shared secret (per docs/auth-contract.md #3)
COURIER_BOT_API_KEY=

# Customer Bot shared secret — used only for POST /users/:id/location, when
# the customer bot forwards a shared Telegram location back to the backend.
CUSTOMER_BOT_API_KEY=

MINI_APP_URL=http://localhost:5173
# This backend's own public origin — used to build absolute URLs for
# uploaded photos (product images, delivery proof).
PUBLIC_API_URL=http://localhost:3000

# Payments (Phase 2 — leave blank until merchant accounts are approved, see docs/decisions.md #3)
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# SMS OTP (Phase 2 — placeholder provider, see docs/decisions.md #2)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

PORT=3000
