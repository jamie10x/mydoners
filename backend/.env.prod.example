# Copy to backend/.env.prod on the server (never commit the real file).
# Hostnames "postgres"/"redis" resolve via Docker's internal network
# (mydoners_net) — not localhost, unlike local dev's docker-compose.yml.

DATABASE_URL=postgres://mydoners:REPLACE_WITH_SAME_PASSWORD_AS_ENV_PROD@postgres:5432/mydoners
REDIS_URL=redis://redis:6379

# The customer-facing bot that serves the Mini App (BotFather) — required
# for Telegram initData verification.
TELEGRAM_BOT_TOKEN=

# Generate with: openssl rand -hex 32
JWT_SECRET=

# Shared secret with courier-bot/.env.prod's COURIER_BOT_API_KEY — must match.
# Generate with: openssl rand -hex 32
COURIER_BOT_API_KEY=

# Payments (Phase 2 — stub provider until real merchant accounts exist, see docs/decisions.md #3)
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# SMS OTP (Phase 2 — stub provider until a real account exists, see docs/decisions.md #2)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

PORT=3000
