# Copy to customer-bot/.env.prod on the server (never commit the real file).
# Must match backend/.env.prod's TELEGRAM_BOT_TOKEN exactly.
TELEGRAM_BOT_TOKEN=

MINI_APP_URL=https://mydoners.uz

# "backend" resolves via Docker's internal network (mydoners_net), not localhost.
BACKEND_URL=http://backend:3000
# Must match backend/.env.prod's CUSTOMER_BOT_API_KEY exactly.
CUSTOMER_BOT_API_KEY=

BOT_MODE=webhook
WEBHOOK_PORT=3002
WEBHOOK_PATH=/telegram-webhook
PUBLIC_WEBHOOK_URL=https://api.mydoners.uz/customer-bot/webhook
