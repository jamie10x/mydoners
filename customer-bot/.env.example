# Telegram bot token for the customer-facing bot (@mydoner_bot) — the same
# bot the Mini App's chat menu button belongs to. Must match backend's
# TELEGRAM_BOT_TOKEN so initData verification and this bot agree on identity.
TELEGRAM_BOT_TOKEN=

# Where the "Order now" button opens.
MINI_APP_URL=http://localhost:5173

# Backend connection — forwards shared locations to POST /users/:id/location.
BACKEND_URL=http://localhost:3000
# Must match backend/.env's CUSTOMER_BOT_API_KEY exactly.
CUSTOMER_BOT_API_KEY=

# Bot update delivery mode — "polling" (default, no public endpoint needed,
# simplest for local dev) or "webhook" (production). See courier-bot/.env.example.
BOT_MODE=polling
WEBHOOK_PORT=3002
WEBHOOK_PATH=/telegram-webhook
PUBLIC_WEBHOOK_URL=
