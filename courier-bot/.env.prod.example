# Copy to courier-bot/.env.prod on the server (never commit the real file).

COURIER_BOT_TOKEN=
COURIER_CHAT_ID=

# "backend" resolves via Docker's internal network (mydoners_net), not localhost.
BACKEND_URL=http://backend:3000
# Must match backend/.env.prod's COURIER_BOT_API_KEY exactly.
COURIER_BOT_API_KEY=

BOT_MODE=webhook
WEBHOOK_PORT=3001
WEBHOOK_PATH=/telegram-webhook
PUBLIC_WEBHOOK_URL=https://api.mydoners.uz/courier-bot/webhook
