# Telegram bot token for the Courier Bot (a separate bot from any customer-facing one)
COURIER_BOT_TOKEN=

# The single dedicated courier's Telegram chat ID. Get this by having the
# courier message the bot once, then reading the chat id from an update log
# (or via @userinfobot). One courier = one hardcoded chat id, per the
# blueprint's "single dedicated courier" scope.
COURIER_CHAT_ID=

# Backend connection
BACKEND_URL=http://localhost:3000
COURIER_BOT_API_KEY=

# Bot update delivery mode — "polling" (default, no public endpoint needed,
# simplest for local dev) or "webhook" (production — needs a real HTTPS URL
# Telegram can reach). See docs/decisions.md #5.
BOT_MODE=polling
WEBHOOK_PORT=3001
WEBHOOK_PATH=/telegram-webhook
# Full public URL Telegram should POST updates to, e.g.
# https://api.mydoners.uz/courier-bot/webhook — required when BOT_MODE=webhook.
PUBLIC_WEBHOOK_URL=
